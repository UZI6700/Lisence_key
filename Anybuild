# Anybuild configuration for Wasmer Edge.
# Builds the NestJS API + React dashboard and serves them from one Edge.js app.

load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "start": "node packages/api/dist/main.js",
    },
    node_build_command = "npm run build:prod",  # generates Prisma client, builds API + web
    node_package_manager = "npm",
    node_server = "node",
    node_version = "24",
    npm_version = "11",
    node_install_inputs = [
        "package.json",
        "package-lock.json",
        "packages/api/package.json",
        "packages/web/package.json",
    ],
)

build = node_build(config)

node_serve(config, build, name = "license-manager")
