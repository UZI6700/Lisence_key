generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH & USER MODELS
// ==========================================

model User {
  id            String        @id @default(cuid())
  supabaseId    String?       @unique // links this row to Supabase Auth
  name          String?
  email         String        @unique
  password      String        // argon2id hashed, or a non-usable placeholder for Supabase users
  role          String        @default("USER") // ADMIN, USER, VIEWER
  status        String        @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  apiKeys       ApiKey[]
  activityLogs  ActivityLog[]
  subscriptions Subscription[]
  devices       Device[]

  @@map("users")
}

// ==========================================
// PRODUCT MODELS
// ==========================================

model Product {
  id                 String   @id @default(cuid())
  name               String
  code               String   @unique
  description        String?
  version            String   @default("1.0.0")
  defaultDeviceLimit Int      @default(3)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  licenses      License[]
  subscriptions Subscription[]

  @@map("products")
}

// ==========================================
// SUBSCRIPTION PLANS
// ==========================================

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   // e.g., "Monthly", "Yearly", "Two Months"
  duration    Int      // in days (30, 60, 365, etc.)
  price       Float    // price amount
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  maxDevices  Int      @default(3)
  maxLicenses Int?
  features    String   @default("[]") // JSON array string
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

// ==========================================
// CUSTOMER MODELS
// ==========================================

model Customer {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  company       String?
  phone         String?
  taxId         String?
  contactPerson String?
  address       String?
  website       String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  licenses License[]

  @@map("customers")
}

// ==========================================
// SUBSCRIPTION MODEL
// ==========================================

model Subscription {
  id                 String           @id @default(cuid())
  user               User             @relation(fields: [userId], references: [id])
  userId             String
  product            Product          @relation(fields: [productId], references: [id])
  productId          String
  subscriptionPlan   SubscriptionPlan @relation(fields: [planId], references: [id])
  planId             String
  startDate          DateTime
  expiryDate         DateTime
  status             String           @default("ACTIVE")
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime
  cancelAt           DateTime?
  canceledAt         DateTime?
  trialEnd           DateTime?
  autoRenew          Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("subscriptions")
}

// ==========================================
// LICENSE MODEL
// ==========================================

model License {
  id                 String        @id @default(cuid())
  licenseKey         String        @unique
  licenseKeyHash     String        // argon2id hash of licenseKey
  status             String        @default("PENDING") // PENDING, ACTIVE, EXPIRED, SUSPENDED, REVOKED
  product            Product       @relation(fields: [productId], references: [id])
  productId          String
  customer           Customer?     @relation(fields: [customerId], references: [id])
  customerId         String?
  deviceId           String?       // fingerprint of activated device
  activatedAt        DateTime?
  firstActivatedAt   DateTime?     // subscription clock starts on first successful activation
  durationDays       Int           @default(365) // authoritative subscription duration
  plan               String        @default("standard")
  expiresAt          DateTime
  issuedAt           DateTime      @default(now())
  maxDevices         Int           @default(3)
  maxUses            Int?
  usesCount          Int           @default(0)
  signaturePayload   String?       // base64url encoded payload
  signatureValidUntil DateTime?
  gracePeriodEnd     DateTime?
  isInGracePeriod    Boolean       @default(false)
  activatedFromIp    String?
  activatedUserAgent String?
  lastValidationAt   DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  devices     Device[]
  activations LicenseActivation[]
  renewals    LicenseRenewal[]
  validations LicenseValidation[]

  @@map("licenses")
}

// ==========================================
// DEVICE MODEL
// ==========================================

model Device {
  id             String   @id @default(cuid())
  fingerprint    String   @unique
  os             String?
  browser        String?
  lastValidation DateTime @default(now())
  status         String   @default("ACTIVE") // ACTIVE, BLOCKED, SUSPENDED
  activatedAt    DateTime?
  activatedAtIp  String?
  userAgent      String?
  license        License? @relation(fields: [licenseId], references: [id])
  licenseId      String?
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activations LicenseActivation[]

  @@map("devices")
}

// ==========================================
// LICENSE ACTIVATIONS (audit trail)
// ==========================================

model LicenseActivation {
  id          String   @id @default(cuid())
  license     License  @relation(fields: [licenseId], references: [id])
  licenseId   String
  device      Device   @relation(fields: [deviceId], references: [id])
  deviceId    String
  activatedAt DateTime  @default(now())
  ipAddress   String?
  userAgent   String?
  success     Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())

  @@map("license_activations")
}

// ==========================================
// LICENSE RENEWALS (audit trail)
// ==========================================

model LicenseRenewal {
  id            String   @id @default(cuid())
  license       License  @relation(fields: [licenseId], references: [id])
  licenseId     String
  previousExpiry DateTime
  newExpiry      DateTime
  renewedAt      DateTime @default(now())
  renewalType    String
  paymentId      String?
  status         String   @default("completed")
  createdAt      DateTime @default(now())

  @@map("license_renewals")
}

// ==========================================
// API KEYS
// ==========================================

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String
  keyPrefix   String
  scopes      String    @default("[\"read:licenses\",\"write:licenses\"]") // JSON array string
  isActive    Boolean   @default(true)
  lastUsed    DateTime?
  usageCount  Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdById String?

  @@map("api_keys")
}

// ==========================================
// ACTIVITY LOGS (audit trail)
// ==========================================

model ActivityLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  details    String?
  createdAt  DateTime @default(now())

  @@map("activity_logs")
}

// ==========================================
// OFFLINE LICENSING CONFIGURATION & AUDIT
// ==========================================

/// Administrator-controlled runtime configuration (no seed/demo records).
/// Known keys: offlineGraceDays (0 = disabled), licenseFileVersion, apiBaseUrl.
model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

/// Every online activation / validation / sync is recorded here so the server
/// can detect suspicious client clocks and revoked-license usage attempts.
model LicenseValidation {
  id                String   @id @default(cuid())
  license           License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  licenseId         String
  deviceFingerprint String?
  result            String   // VALID, INVALID, EXPIRED, REVOKED, DEVICE_MISMATCH ...
  reason            String?
  clientTime        DateTime?
  serverTime        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([licenseId, createdAt])
  @@map("license_validations")
}
